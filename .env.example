# Copie este arquivo para .env e preencha com os dados do seu PostgreSQL.
# O .env é carregado automaticamente pelo app.py.

# URL completa de conexão (tem prioridade sobre as variáveis DB_*)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/analiseMeteorologica

# Alternativa: configurar os campos separadamente
# DB_USER=usuario
# DB_PASSWORD=senha
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=analiseMeteorologica

# Geocodificação (Nominatim/OpenStreetMap)
# Ajuste o User-Agent com um contato válido para uso em produção.
# GEOCODIFICACAO_URL=https://nominatim.openstreetmap.org/search
# GEOCODIFICACAO_REVERSA_URL=https://nominatim.openstreetmap.org/reverse
# GEOCODIFICACAO_TIMEOUT=10
# GEOCODIFICACAO_INTERVALO=1.1
# GEOCODIFICACAO_USER_AGENT=AnaliseDeDadosMeteorologicos/1.0
